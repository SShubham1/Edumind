# EduMind backend configuration. Copy to .env and adjust as needed.
# Never commit a real .env file or a real API key.

APP_NAME=EduMind API
ENVIRONMENT=development

# SQLite locally. For PostgreSQL install psycopg and use:
# DATABASE_URL=postgresql+psycopg://edumind:edumind@localhost:5432/edumind
DATABASE_URL=sqlite:///./edumind.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Simplified Bayesian Knowledge Tracing parameters.
BKT_PRIOR=0.30
BKT_LEARN=0.18
BKT_GUESS=0.20
BKT_SLIP=0.10

# Recommendation weights: R(t) = w1(1-M) + w2*F + w3*D + w4*W
REC_WEIGHT_MASTERY=0.45
REC_WEIGHT_REVISION=0.20
REC_WEIGHT_DIFFICULTY=0.15
REC_WEIGHT_WEAKNESS=0.20
REVISION_WINDOW_DAYS=14

# Server-side LLM. Leave LLM_API_KEY empty to use deterministic plan and
# flashcard fallbacks. Quiz generation has no fallback and returns 503.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Quiz calls are longer; reasoning models may need the extra budget.
LLM_QUIZ_TIMEOUT_SECONDS=90
LLM_QUIZ_MAX_TOKENS=4000
